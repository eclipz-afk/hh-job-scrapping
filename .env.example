# PostgreSQL
# Optional full SQLAlchemy URL (overrides host/user/password fields below)
# DATABASE_URL=postgresql+psycopg://jobs:jobs@localhost:5432/jobsdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
POSTGRES_DB=jobsdb
POSTGRES_USER=jobs
POSTGRES_PASSWORD=replace-with-a-unique-random-password

# Flask
FLASK_ENV=production
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ETL
# Generate a random token; leave empty to disable ingestion over HTTP.
ETL_API_TOKEN=
TARGET_CLEANED_ROWS=5000
MAX_SOURCE_PAGES=260
BATCH_SIZE=500
REQUEST_TIMEOUT_SECONDS=20

# Dashboard
FRONTEND_API_BASE=http://localhost:5000/api/v1
